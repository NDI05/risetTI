PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/risetti.sqlite
TRUST_PROXY_HOPS=0

# Wajib diisi untuk deployment Docker dengan domain publik.
DOMAIN=

# Isi untuk membuat akun admin awal pada startup pertama. Gunakan kata sandi kuat.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI hanya boleh memakai Ollama di komputer lokal. Jangan isi dengan URL layanan cloud.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M

# Aktifkan hanya jika aplikasi dilayani melalui HTTPS.
COOKIE_SECURE=false

# Backup berkala dijalankan oleh layanan backup Docker.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
