{
  "name": "risetti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-public.mjs",
    "start": "node dist/src/server.js",
    "backup": "node scripts/backup-database.mjs",
    "import:openalex": "tsx scripts/import-openalex.ts",
    "lint": "eslint src tests scripts public/app.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
